{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Katalog Desa Banjar Agung - Fase 1 Auth",
    "description": "Koleksi pengujian autentikasi Sanctum SPA (cookie + CSRF) untuk backend Laravel Katalog Desa Banjar Agung.\n\nUrutan pengujian:\n1. Ambil CSRF Cookie\n2. Login Admin\n3. Profil Admin\n4. Logout Admin\n5. Profil Admin Tanpa Sesi (harus 401)\n\nPastikan cookie jar Postman aktif dan backend berjalan di http://localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173"
    },
    {
      "key": "adminEmail",
      "value": "admin@banjaragung.desa.id"
    },
    {
      "key": "adminPassword",
      "value": "Admin12345!"
    }
  ],
  "item": [
    {
      "name": "1. Ambil CSRF Cookie",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test('Cookie XSRF-TOKEN tersedia', function () {",
              "    pm.expect(pm.cookies.get('XSRF-TOKEN')).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sanctum/csrf-cookie",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sanctum",
            "csrf-cookie"
          ]
        },
        "description": "Mengambil cookie laravel_session dan XSRF-TOKEN. Jalankan request ini terlebih dahulu."
      }
    },
    {
      "name": "2. Login Admin",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.cookies.get('XSRF-TOKEN');",
              "if (!token) {",
              "    throw new Error('Cookie XSRF-TOKEN belum ada. Jalankan request Ambil CSRF Cookie terlebih dahulu.');",
              "}",
              "pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(token) });"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Login berhasil dan mengembalikan admin', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql('Login berhasil.');",
              "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('adminEmail'));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Referer",
            "value": "{{frontendOrigin}}/"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"remember\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Header X-XSRF-TOKEN diisi otomatis dari cookie oleh pre-request script. Header Origin wajib cocok dengan SANCTUM_STATEFUL_DOMAINS."
      }
    },
    {
      "name": "3. Profil Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Data admin sesuai', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('adminEmail'));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "me"
          ]
        },
        "description": "Endpoint terlindungi. Harus berhasil setelah login."
      }
    },
    {
      "name": "4. Logout Admin",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const token = pm.cookies.get('XSRF-TOKEN');",
              "if (!token) {",
              "    throw new Error('Cookie XSRF-TOKEN belum ada. Jalankan request Ambil CSRF Cookie terlebih dahulu.');",
              "}",
              "pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(token) });"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Logout berhasil', function () {",
              "    pm.expect(pm.response.json().message).to.eql('Logout berhasil.');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Referer",
            "value": "{{frontendOrigin}}/"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        },
        "description": "Menghapus session admin."
      }
    },
    {
      "name": "5. Profil Admin Tanpa Sesi (harus 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Pesan 401 berbahasa Indonesia', function () {",
              "    pm.expect(pm.response.json().message).to.include('Sesi tidak valid');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "me"
          ]
        },
        "description": "Membuktikan endpoint admin menolak request tanpa session."
      }
    }
  ]
}
